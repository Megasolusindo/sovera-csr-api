PORT=4000
NODE_ENV=development
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sovera_db?sslmode=disable
REDIS_URL=localhost:6379
WEBHOOK_SECRET_KEY=your_webhook_secret_key_here
JWT_SECRET=your_jwt_secret_key_here
AI_API_KEY=your_gemini_api_key_here
SCRAPER_SERVICE_URL=http://localhost:8088/api/v1/scrape-tasks
SCRAPER_API_KEY=your_scraper_api_key_here
WEBHOOK_URL=http://localhost:4000/api/v1/webhooks/crawler?secret=your_webhook_secret_key_here

# S3-Compatible Object Storage Settings (AWS S3 / MinIO / Cloudflare R2 / DigitalOcean Spaces)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=sovera-templates
S3_REGION=us-east-1
S3_ACCESS_KEY=your_s3_access_key
S3_SECRET_KEY=your_s3_secret_key
STORAGE_LOCAL_DIR=/tmp/sovera_storage

# Telegram Webhook Notifier & Automated Alerting Settings
TELEGRAM_BOT_TOKEN=8123456789:AA_YourBotTokenFromBotFather
TELEGRAM_CHAT_ID=-100123456789

# Payment Gateway Configuration (Options: "midtrans" | "faspay")
ACTIVE_PAYMENT_GATEWAY=midtrans

# Midtrans Payment Gateway Configuration
MIDTRANS_SERVER_KEY=SB-Mid-server-YOUR_SERVER_KEY
MIDTRANS_CLIENT_KEY=SB-Mid-client-YOUR_CLIENT_KEY
MIDTRANS_IS_PRODUCTION=false

# Faspay Payment Gateway Configuration
FASPAY_MERCHANT_ID=your_faspay_merchant_id
FASPAY_MERCHANT_KEY=your_faspay_merchant_key
FASPAY_IS_PRODUCTION=false
FASPAY_RETURN_URL=http://localhost:3000/settings/subscription